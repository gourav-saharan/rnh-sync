rules_version = '2';

// Firestore security rules for the R&H Tyre Testing System.
//
// Role model (v2): users/{uid}.roles is a list of 'Tester' | 'Report_Viewer'
// | 'Template_Admin' (one user may hold several, R1.3). Self-registration
// creates only ['Tester']; office roles come from tools/seed-users.mjs.
//
// Summary (full role x path x operation matrix:
// tests/security-rules/securityRulesMatrix.test.ts):
//   - Unauthenticated / no-profile users are denied everything except
//     reading and creating their own profile.
//   - Testers create v2 sessions they own and edit own/assigned sessions,
//     their photos and history; they never assign, trash or record reports.
//   - Report_Viewers review/correct any session, assign testers, trash and
//     restore, and permanently delete after 30 days in the trash (R13.2).
//   - Template_Admins manage templates; published versions and their
//     workbook blobs are immutable (R2.4, R14.3).
//   - Workbooks and photos are chunked Firestore blobs (no Cloud Storage).
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    // v2 role model: `roles: Role[]` on users/{uid} (one user may hold several
    // roles, R1.3). The legacy single `role` field is still honoured so v1
    // accounts keep working until they are migrated (tools/migrate-v1-to-v2).
    // No Cloud Functions: everything is enforced here (R14.1).

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(r) {
      return isSignedIn() && hasUserDoc() && (
        (userDoc().get('roles', []) is list && r in userDoc().get('roles', []))
        || userDoc().get('role', '') == r
      );
    }

    function isTester() { return hasRole('Tester'); }
    function isReportViewer() { return hasRole('Report_Viewer'); }
    // Legacy v1 Report_Viewers (single `role`, no `roles` list) managed
    // templates; keep that until they are re-seeded (matches rolesFromDoc).
    function isLegacyViewer() {
      return isSignedIn() && hasUserDoc()
        && !(userDoc().get('roles', null) is list)
        && userDoc().get('role', '') == 'Report_Viewer';
    }
    function isTemplateAdmin() { return hasRole('Template_Admin') || isLegacyViewer(); }
    function hasAnyRole() { return isTester() || isReportViewer() || isTemplateAdmin(); }

    // 30-day trash window (R13.2); deletedAt is epoch ms.
    function trashExpired(data) {
      return data.get('deletedAt', null) is number
        && request.time.toMillis() - data.deletedAt > 30 * 24 * 60 * 60 * 1000;
    }

    // Tester may edit sessions they created or are assigned to (R14.2).
    function testerOwns(data) {
      return data.createdBy == request.auth.uid
        || (data.get('assignedTo', []) is list && request.auth.uid in data.get('assignedTo', []));
    }

    // --- users/{uid} -------------------------------------------------------
    // Read own profile. Self-registration may create the OWN doc once with
    // `roles == ['Tester']` only. Report_Viewer, Template_Admin and
    // multi-role grants come only from tools/seed-users.mjs (Admin SDK).
    // The only self-service change afterwards is adding Tester (below).
    match /users/{uid} {
      // Own profile; Report_Viewers may also list the team to assign testers.
      allow read: if isSignedIn() && (request.auth.uid == uid || isReportViewer());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        // Self-registration is Tester only (design "Security Rules (v2)").
        // Office roles come only from tools/seed-users.mjs (Admin SDK).
        // No legacy `role` field: hasRole() also honours it, so allowing it
        // here would let a client smuggle in Report_Viewer.
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'roles', 'createdAt'])
        && request.resource.data.roles == ['Tester'];
      // The only self-service change: an existing account may add the Tester
      // role to itself (so an office account can also capture on the phone).
      // Tester is the lowest role and self-sign-up already grants it, so this
      // is not an escalation. Every other field and every other role is fixed.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles'])
        && resource.data.get('roles', null) is list
        && !('Tester' in resource.data.roles)
        && request.resource.data.roles is list
        && request.resource.data.roles.hasAll(resource.data.roles)
        && request.resource.data.roles.size() == resource.data.roles.size() + 1
        && 'Tester' in request.resource.data.roles;
      allow delete: if false;
    }

    // --- customerTemplates/{templateId} -----------------------------------
    // Everyone with a role may read (Testers need the list + published
    // versions offline, R8.4). Only Template_Admins write (R14.3). Report_
    // Viewers keep v1 write access until the v1 laptop screens are removed.
    match /customerTemplates/{templateId} {
      allow read: if hasAnyRole();
      allow create, update: if isTemplateAdmin() || isReportViewer();
      allow delete: if isTemplateAdmin();

      // Published Template_Versions are immutable for everyone (R2.4, R14.3).
      match /versions/{version} {
        allow read: if hasAnyRole();
        allow create: if isTemplateAdmin()
          && request.resource.data.templateId == templateId;
        allow update, delete: if false;
      }

      // Binary Excel workbooks stored in Firestore (replaces Cloud Storage).
      // `draft` is editable; published `v{n}` blobs are create-once and
      // immutable like their version docs (R2.4, R14.3).
      match /blobs/{blobId} {
        allow read: if hasAnyRole();
        allow write: if blobId == 'draft' && (isTemplateAdmin() || isReportViewer());
        allow create: if blobId != 'draft' && isTemplateAdmin();

        // Chunks are written before the meta doc (blobs.ts). A version blob's
        // chunks may be (re)written only until its meta exists, so a failed
        // publish can be retried but a published workbook never changes.
        match /chunks/{chunkId} {
          allow read: if hasAnyRole();
          allow write: if blobId == 'draft' && (isTemplateAdmin() || isReportViewer());
          allow create, update: if blobId != 'draft' && isTemplateAdmin()
            && !exists(/databases/$(database)/documents/customerTemplates/$(templateId)/blobs/$(blobId));
        }
      }

      // v1 Field_Mappings (legacy, removed with the v1 screens).
      match /fieldMappings/{mappingId} {
        allow read: if hasAnyRole();
        allow write: if isTemplateAdmin() || isReportViewer();
      }
    }

    // --- Session-scoped write helpers ---------------------------------------
    function sessionDoc(sid) {
      return get(/databases/$(database)/documents/testSessions/$(sid));
    }

    // Report_Viewer, or a Tester who owns / is assigned to the session (R14.2).
    // The session must already exist (the phone pushes it before photos).
    function canWriteSession(sid) {
      return isReportViewer()
        || (isTester()
          && exists(/databases/$(database)/documents/testSessions/$(sid))
          && testerOwns(sessionDoc(sid).data));
    }

    // Photo meta written by blobs.ts writeFirestoreBlob: images < 5 MB
    // (matches apps/mobile-pwa/src/v2/photos.ts MAX_PHOTO_BYTES), signed by
    // the writer, at most 11 chunks of 500 KB.
    function validPhotoMeta() {
      let d = request.resource.data;
      return d.contentType is string && d.contentType.matches('image/.*')
        && d.size is int && d.size > 0 && d.size < 5 * 1024 * 1024
        && d.chunkCount is int && d.chunkCount >= 1 && d.chunkCount <= 11
        && d.updatedBy == request.auth.uid;
    }

    function validChunk() {
      return request.resource.data.data is bytes
        && request.resource.data.data.size() <= 500 * 1024;
    }

    // --- testSessions/{sessionId} -----------------------------------------
    match /testSessions/{sessionId} {
      allow read: if hasAnyRole();

      // Tester creates a v2 session they own (R14.2).
      allow create: if isTester()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('schemaVersion', 0) == 2;

      // Tester edits own / assigned sessions; Report_Viewer edits any
      // (review + correction, trash, restore). Owner can never be changed.
      allow update: if request.resource.data.createdBy == resource.data.createdBy
        && (
          (isTester() && testerOwns(resource.data)
            // Testers can never change who a test is assigned to,
            && request.resource.data.get('assignedTo', []) == resource.data.get('assignedTo', [])
            // never record a report (laptop only, R12),
            && !('lastReport' in request.resource.data.diff(resource.data).affectedKeys())
            // and never move a test to the trash. Restoring (deletedAt ->
            // null) stays allowed: the phone's "keep my edits" path (R13.3).
            && (!('deletedAt' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.deletedAt == null))
          || isReportViewer()
        );

      // Permanent delete only from the trash after 30 days (R13.2).
      allow delete: if isReportViewer() && trashExpired(resource.data);

      // Append-only edit history (R10.4), only on sessions the writer may edit.
      match /history/{entryId} {
        allow read: if hasAnyRole();
        allow create: if canWriteSession(sessionId)
          && request.resource.data.by == request.auth.uid;
        allow update: if false;
        // Only as part of a permanent delete: Report_Viewer, parent session
        // 30+ days in the trash (purge deletes children before the session).
        allow delete: if isReportViewer()
          && exists(/databases/$(database)/documents/testSessions/$(sessionId))
          && trashExpired(sessionDoc(sessionId).data);
      }

      // Tyre photos stored in Firestore (replaces Cloud Storage). Re-upload
      // of the same path (a retry) is an update; only Report_Viewer deletes.
      match /photos/{photoId} {
        allow read: if hasAnyRole();
        allow create, update: if canWriteSession(sessionId) && validPhotoMeta();
        allow delete: if isReportViewer();

        match /chunks/{chunkId} {
          allow read: if hasAnyRole();
          allow create, update: if canWriteSession(sessionId) && validChunk();
          allow delete: if isReportViewer();
        }
      }
    }

    // Alternate alias for tyre photos: sessions/{sessionId}/photos/{photoId}.
    // blobs.ts maps this prefix to testSessions/, so clients do not write
    // here today; the same checks apply in case they do.
    match /sessions/{sessionId}/photos/{photoId} {
      allow read: if hasAnyRole();
      allow create, update: if canWriteSession(sessionId) && validPhotoMeta();
      allow delete: if isReportViewer();

      match /chunks/{chunkId} {
        allow read: if hasAnyRole();
        allow create, update: if canWriteSession(sessionId) && validChunk();
        allow delete: if isReportViewer();
      }
    }
  }
}

