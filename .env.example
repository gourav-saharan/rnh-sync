# Firebase Web SDK configuration for the R&H Tyre Testing System.
# Copy to `.env` (or `apps/<app>/.env.local`) and fill in real values from the
# Firebase console (Project settings -> Your apps). All keys are required.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Realtime Database URL. Not used by this app today; harmless to set.
VITE_FIREBASE_DATABASE_URL=

# Optional. Only needed to enable browser-only Firebase Analytics. When empty,
# Analytics stays disabled (initAnalytics() returns null). Safe to leave blank.
VITE_FIREBASE_MEASUREMENT_ID=

# Point the SDK at the local Emulator Suite instead of a live project.
# Accepts `true` or `1`. Leave unset/false for production.
VITE_FIREBASE_USE_EMULATORS=false

# Optional emulator overrides. Defaults match `firebase.json`.
# VITE_FIREBASE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
# VITE_FIREBASE_EMULATOR_FIRESTORE_HOST=127.0.0.1
# VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
# VITE_FIREBASE_EMULATOR_STORAGE_HOST=127.0.0.1
# VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199
